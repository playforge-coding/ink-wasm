{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "outDir": "dist"
  },
  "include": [
    "src",
    "vite.config.ts",
    "wasm-build/*.d.ts",
    "wasm-build-umd/*.d.ts",
    "wasm-build-umd/*.d.cts",
    "wasm-build-legacy/*.d.ts",
    "wasm-build-legacy/*.d.cts"
  ]
}
