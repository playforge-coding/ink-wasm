# WebAssembly build targets for Google Ink.
#
# This package is staged into the cloned ink repo at //wasm by setup.js. Each
# `ink*` cc_binary links the core ink libraries together with our Embind
# glue; `wasm_cc_binary` transitions that target (and all of its transitive
# deps) onto the emscripten toolchain and emits the .js/.wasm.
#
# Three variants share the same C++ source and deps, differing only in the
# Emscripten JS-glue flags:
#   ink        - ES module glue (import.meta.url-based resolution), for the
#                ESM bundle. Also supports Node.
#   ink_umd    - classic-script glue (document.currentScript-based
#                resolution; import.meta.url is invalid outside ES modules,
#                so this build cannot use EXPORT_ES6), for the UMD bundle.
#                Browser/worker only.
#   ink_legacy - same classic-script glue as ink_umd, compiled to asm.js
#                (WASM=0) instead of WebAssembly, for browsers without wasm
#                support. Browser/worker only.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")

package(default_visibility = ["//visibility:public"])

INK_DEPS = [
    "//ink/brush",
    "//ink/brush:brush_family",
    "//ink/brush:stock_brushes",
    "//ink/color",
    "//ink/geometry:mesh",
    "//ink/geometry:partitioned_mesh",
    "//ink/geometry:point",
    "//ink/strokes:stroke",
    "//ink/strokes/input:stroke_input",
    "//ink/strokes/input:stroke_input_batch",
    "//ink/types:duration",
    "@abseil-cpp//absl/status:statusor",
    "@abseil-cpp//absl/types:span",
]

cc_binary(
    name = "ink",
    srcs = ["bindings.cc"],
    linkopts = [
        "-lembind",
        "-O3",
        "--no-entry",
        "-sMODULARIZE=1",
        "-sEXPORT_ES6=1",
        "-sEXPORT_NAME=createInkModule",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sENVIRONMENT=web,worker,node",
        "-sFILESYSTEM=0",
    ],
    deps = INK_DEPS,
)

wasm_cc_binary(
    name = "ink_wasm",
    cc_target = ":ink",
)

cc_binary(
    name = "ink_umd",
    srcs = ["bindings.cc"],
    linkopts = [
        "-lembind",
        "-O3",
        "--no-entry",
        "-sMODULARIZE=1",
        "-sEXPORT_NAME=createInkModule",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sENVIRONMENT=web,worker",
        "-sFILESYSTEM=0",
    ],
    deps = INK_DEPS,
)

wasm_cc_binary(
    name = "ink_wasm_umd",
    cc_target = ":ink_umd",
)

cc_binary(
    name = "ink_legacy",
    srcs = ["bindings.cc"],
    linkopts = [
        "-lembind",
        "-O3",
        "--no-entry",
        "-sMODULARIZE=1",
        "-sEXPORT_NAME=createInkModule",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sENVIRONMENT=web,worker",
        "-sFILESYSTEM=0",
        "-sWASM=0",
    ],
    deps = INK_DEPS,
)

wasm_cc_binary(
    name = "ink_wasm_legacy",
    cc_target = ":ink_legacy",
)
