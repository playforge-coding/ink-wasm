{
  "name": "ink-wasm",
  "version": "0.1.1",
  "description": "Google Ink (freehand stroke generation) compiled to WebAssembly, bundled with tsdown, with TypeScript types and Canvas2D / WebGL / CanvasKit (Skia) rendering backends.",
  "keywords": [
    "canvas",
    "canvaskit",
    "drawing",
    "freehand",
    "google-ink",
    "handwriting",
    "ink",
    "mesh",
    "skia",
    "stroke",
    "stylus",
    "wasm",
    "webassembly",
    "webgl"
  ],
  "homepage": "https://github.com/playforge-coding/ink-wasm#readme",
  "bugs": {
    "url": "https://github.com/playforge-coding/ink-wasm/issues"
  },
  "license": "Apache-2.0",
  "author": "playforge-coding",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playforge-coding/ink-wasm.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./umd": "./dist/umd/index.js",
    "./umd/renderer": "./dist/umd/renderer.js",
    "./umd/ink_umd.wasm": "./dist/umd/ink_umd.wasm",
    "./legacy": "./dist/legacy/index.js",
    "./ink.wasm": "./dist/ink.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:js": "vp pack && node scripts/build-legacy.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "serve": "cd examples && cp -r ../dist ./ && pnpm dlx serve",
    "clean": "node scripts/clean.mjs",
    "prepublishOnly": "node -e \"const fs=require('fs');for(const f of ['dist/index.js','dist/index.d.ts','dist/ink.wasm','dist/umd/index.js','dist/umd/ink_umd.wasm','dist/legacy/index.js'])fs.accessSync(f);console.log('dist artifacts present')\""
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.9.0",
    "vite-plus": "^0.2.8"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.2"
}
